# Virtual environments
venv/
.venv/
ENV/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Sensitive files - never copy into image
session/
*.session
*.session-journal
.env
.env.*
!.env.example

# IDE and OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Git
.git/
.gitignore

# Documentation (not needed in runtime image)
docs/
*.md

# Docker files (not needed in image)
Dockerfile
docker-compose.yml
.dockerignore

# Tests and logs
tests/
logs/
*.log
