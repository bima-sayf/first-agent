TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Bot token from @BotFather (talk to @BotFather on Telegram to create a bot)
BOT_TOKEN=your_bot_token_here

# Optional override — only needed if you change the model in model-init
OLLAMA_MODEL=hermes3

# Allowed chats (comma-separated)
# Use negative numbers for group/supergroup chat IDs
# Example: ALLOWED_CHATS=-1001234567890,-1009876543210
# Bot will respond to mentions (@botname) and replies in these chats
ALLOWED_CHATS=-5556749038
